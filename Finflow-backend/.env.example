# Template only — copy it, never edit this file with real values.
#   cp .env.example .env
# .env is gitignored; this file is committed, so it must stay free of secrets.

NODE_ENV=development
PORT=3000

# Origin of the React app, used for CORS. Comma-separate for multiple.
CLIENT_ORIGIN=http://localhost:5173

# MongoDB connection string.
#   Local:  mongodb://127.0.0.1:27017/finflow
#   Atlas:  mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/finflow?retryWrites=true&w=majority
#
# Transfers use multi-document transactions, which need a replica set — Atlas
# provides one, a standalone local mongod does not. The API still works on
# standalone; it warns once and runs those writes non-atomically.
MONGODB_URI=mongodb://127.0.0.1:27017/finflow

# Secret for signing short-lived access tokens.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-me-with-a-long-random-string

# How long an access token stays valid (zeit/ms format: 15m, 1h, 7d).
JWT_ACCESS_TTL=15m

# How many days a refresh token stays valid before the user must log in again.
JWT_REFRESH_TTL_DAYS=7

# Bcrypt work factor. 12 is a good default; lower it to 4 in tests for speed.
BCRYPT_ROUNDS=12

# --- Investment prices -------------------------------------------------------
# Holdings default to the "manual" price provider, which needs no network and
# no key: you set the price. Everything below only matters once a holding is
# switched to a live provider.

# How long a fetched price is reused before the vendor is asked again. Free
# price APIs rate-limit hard, so this is the main protection for your quota.
PRICE_CACHE_TTL_MINUTES=15

# Background price refresh. Off by default, and always off under NODE_ENV=test.
PRICE_SYNC_ENABLED=false
PRICE_SYNC_INTERVAL_MINUTES=15

# CoinGecko needs no API key. Adding an equity provider means writing a module
# alongside src/services/price/coingecko.provider.js and listing it in
# src/services/price/index.js.
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3

# --- Exchange rates ----------------------------------------------------------
# Amounts are converted into your base currency before any total is reported.
# A pair with no rate is excluded from the total and listed, never guessed.

# "manual" means rates are only ever what you enter through PUT /api/fx/rates.
# "frankfurter" pulls ECB reference rates — no API key, ~30 major currencies,
# one fixing per weekday (so it is a valuation rate, not a dealing rate).
FX_PROVIDER=manual

# Beyond this age a stored rate is reported as stale. It is still used — a
# stale rate beats none — but every response that relies on it says so.
# Two days covers a weekend, since the ECB does not publish on one.
FX_RATE_MAX_AGE_HOURS=48

# Background refresh. Off by default, and always off under NODE_ENV=test.
FX_SYNC_ENABLED=false
FX_SYNC_INTERVAL_MINUTES=720
FRANKFURTER_BASE_URL=https://api.frankfurter.app
