{
  "name": "finflow",
  "private": true,
  "version": "1.0.0",
  "description": "FinFlow — personal finance & investment analytics",
  "license": "ISC",
  "workspaces": [
    "Finflow-backend",
    "Finflow-frontend"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev --workspace finflow-backend",
    "dev:web": "npm run dev --workspace finflow-frontend",
    "start": "npm start --workspace finflow-backend",
    "build": "npm run build --workspace finflow-frontend",
    "seed": "npm run seed --workspace finflow-backend",
    "test": "npm test --workspace finflow-backend",
    "smoke": "npm run smoke --workspace finflow-backend",
    "check": "npm test && npm run smoke"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "engines": {
    "node": ">=22"
  }
}
