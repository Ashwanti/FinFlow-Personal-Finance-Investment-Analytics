# Copy to .env only if you need to override the defaults.

# Where the dev server proxies /api. Change this if the backend is not on 3000.
VITE_PROXY_TARGET=http://localhost:3000

# Leave unset in development — requests go to /api on this same origin through
# the proxy, so the httpOnly refresh cookie works with no CORS involved.
#
# Set it only when the built app is served from a different origin than the
# API. The backend must then list that origin in its own CLIENT_ORIGIN.
# VITE_API_URL=https://api.example.com
